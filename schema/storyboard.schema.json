{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yordi68/ai-content-generation/schema/storyboard.schema.json",
  "title": "Storyboard",
  "description": "The contract between every pipeline stage. Each stage reads this file and writes its own output.",
  "type": "object",
  "required": ["title", "aspect_ratios", "style_block", "character", "voice", "music", "shots"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "aspect_ratios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["9:16", "16:9"] }
    },
    "style_block": {
      "type": "string",
      "minLength": 1,
      "description": "Added to every keyframe prompt so the look stays consistent."
    },
    "character": {
      "type": "string",
      "minLength": 1,
      "description": "Added to every keyframe prompt that shows the developer."
    },
    "voice": {
      "type": "object",
      "required": ["provider", "models", "voice_name", "style", "tempo"],
      "additionalProperties": false,
      "properties": {
        "provider": { "const": "gemini" },
        "models": {
          "type": "array",
          "minItems": 1,
          "description": "Tried in order. The first is the primary model; later ones are used when quota runs out.",
          "items": { "type": "string", "minLength": 1 }
        },
        "voice_name": { "type": "string", "minLength": 1 },
        "style": { "type": "string", "minLength": 1 },
        "tempo": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.3,
          "description": "Speed-up applied to each clip in assembly. 1.08 means 8% faster."
        }
      }
    },
    "music": {
      "type": "array",
      "description": "Music cues. Empty until the score stage.",
      "items": {
        "type": "object",
        "required": ["id", "start_shot", "end_shot", "caption"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "start_shot": { "type": "integer", "minimum": 1 },
          "end_shot": { "type": "integer", "minimum": 1 },
          "caption": { "type": "string", "minLength": 1 }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/shot" }
    }
  },
  "$defs": {
    "shot": {
      "type": "object",
      "required": ["id", "narration", "picture", "motion", "duration_s", "seed", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "narration": {
          "type": "string",
          "minLength": 1,
          "description": "The spoken line for this shot. Also the subtitle text."
        },
        "picture": {
          "type": "string",
          "minLength": 1,
          "description": "Scene description only. Style and character come from the film-level fields."
        },
        "motion": {
          "type": "object",
          "required": ["type", "amount"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["push-in", "pull-out", "pan-left", "pan-right", "none"] },
            "amount": { "enum": ["slow", "none"] }
          }
        },
        "duration_s": {
          "description": "Set from the narration audio after the TTS stage. Null until then.",
          "anyOf": [
            { "type": "null" },
            { "type": "number", "minimum": 2, "maximum": 12 }
          ]
        },
        "seed": { "type": "integer", "minimum": 0 },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "One sentence on why this shot exists."
        }
      }
    }
  }
}
