{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yordi68/ai-content-generation/schema/storyboard.schema.json",
  "title": "Storyboard",
  "description": "The contract between every pipeline stage. Each stage reads this file and writes its own output.",
  "type": "object",
  "required": ["title", "aspect_ratios", "style_block", "character", "voice", "music", "shots"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "title_local": {
      "type": "string",
      "minLength": 1,
      "description": "Optional title in the narration language, shown on the end card under the English title."
    },
    "aspect_ratios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["9:16", "16:9"] }
    },
    "style_block": {
      "type": "string",
      "minLength": 1,
      "description": "Added to every keyframe prompt so the visual medium and palette stay consistent."
    },
    "character": {
      "type": "string",
      "minLength": 1,
      "description": "Full character sheet description used for the reference sheet."
    },
    "characters": {
      "type": "object",
      "description": "Named character descriptions selectively injected only into shots where that character appears.",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "voice": {
      "type": "object",
      "required": ["provider", "models", "voice_name", "style", "tempo"],
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["gemini", "edge-tts"] },
        "models": {
          "type": "array",
          "minItems": 1,
          "description": "Tried in order. The first is the primary model; later ones are used when quota runs out.",
          "items": { "type": "string", "minLength": 1 }
        },
        "voice_name": { "type": "string", "minLength": 1 },
        "style": {
          "type": "string",
          "minLength": 1,
          "description": "Editorial direction note (not sent as a prompt prefix on Amharic TTS to avoid English language bleed)."
        },
        "tempo": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.3,
          "description": "Speed-up applied to each clip in assembly. 1.0 means natural speed."
        }
      }
    },
    "music": {
      "type": "array",
      "minItems": 1,
      "description": "Music cues with shot boundaries.",
      "items": {
        "type": "object",
        "required": ["id", "start_shot", "end_shot", "caption"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "start_shot": { "type": "integer", "minimum": 1 },
          "end_shot": { "type": "integer", "minimum": 1 },
          "caption": { "type": "string", "minLength": 1 }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/shot" }
    }
  },
  "$defs": {
    "shot": {
      "type": "object",
      "required": ["id", "narration", "subtitle", "picture", "characters", "motion", "duration_s", "seed", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 12 },
        "narration": {
          "type": "string",
          "minLength": 1,
          "description": "The spoken line for this shot, in the narration language."
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "description": "The on-screen English subtitle for this shot."
        },
        "picture": {
          "type": "string",
          "minLength": 1,
          "description": "Scene description. Style and active characters come from film-level fields."
        },
        "characters": {
          "type": "array",
          "description": "Keys from film-level characters present in this shot ([] for landscape/sky establishing shots).",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "motion": {
          "type": "object",
          "required": ["type", "amount"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["push-in", "pull-out", "pan-left", "pan-right", "none"] },
            "amount": { "enum": ["slow", "gentle", "none"] }
          }
        },
        "duration_s": {
          "description": "Set from the narration audio after the TTS stage. Null until then.",
          "anyOf": [
            { "type": "null" },
            { "type": "number", "minimum": 2, "maximum": 20 }
          ]
        },
        "seed": { "type": "integer", "minimum": 0 },
        "reason": {
          "type": "string",
          "minLength": 10,
          "description": "Narrative and emotional reason why this shot exists."
        }
      }
    }
  }
}
