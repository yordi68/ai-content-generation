outputs/keyframes/*
!outputs/keyframes/*.json
!outputs/shots/
outputs/shots/*
!outputs/shots/*.json
!outputs/music/
outputs/music/*
!outputs/music/*.json

# Python
__pycache__/
*.pyc
.venv/
venv/

